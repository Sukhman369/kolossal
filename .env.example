# ==========================================
# BEYOND HUMANS COMMERCE ENGINE CONFIGURATION
# ==========================================

# Active Commerce Provider: 'mock' | 'medusa' | 'shopify'
NEXT_PUBLIC_COMMERCE_PROVIDER=mock

# ------------------------------------------
# MedusaJS v2 Configuration (if provider is 'medusa')
# ------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------
# Shopify Storefront API (if provider is 'shopify')
# ------------------------------------------
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=beyondhumans-apparel.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
